# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Neon (created through Vercel's Neon integration): pooled connection strings.
# dev branch: the app in `npm run dev`
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# test branch: e2e only; reset and reseeded on every run
E2E_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Mail: `outbox` writes messages to .data/outbox/ (local only; refused on Vercel)
MAIL_TRANSPORT=outbox
